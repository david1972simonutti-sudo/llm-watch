<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.david.llmwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/david/llm-watch/run_weekly.sh</string>   <!-- À ADAPTER -->
    </array>
    <!-- Lundi (Weekday=1) 08:00. Mac endormi -> exécution au réveil (une fois).
         Mac éteint -> run sauté. -->
    <key>StartCalendarInterval</key>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>/Users/david/llm-watch/logs/launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Users/david/llm-watch/logs/launchd.err.log</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
